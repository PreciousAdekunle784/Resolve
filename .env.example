# =============================================================================
# Resolve — environment variables
# Copy this file to `.env.local` for local development and fill in the values.
# NEVER commit `.env.local` or any real keys. `.env*` files are git-ignored
# (except this example).
# =============================================================================

# --- Site -------------------------------------------------------------------
# Public address of the app. Used in email links (confirmation, password reset).
# Local: http://localhost:3000   Production: https://your-domain.com
# (On Vercel this can be left out — the production address is detected.)
SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys in the Supabase dashboard) --------
# No NEXT_PUBLIC_ prefix is needed. (The NEXT_PUBLIC_ versions also work.)
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Publishable key (starts with sb_publishable_…) — or SUPABASE_ANON_KEY for the
# legacy "anon" key. Safe to share with browsers: data is protected by RLS.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_…) or the legacy "service_role" key
# (SUPABASE_SERVICE_ROLE_KEY also works). SERVER ONLY — bypasses Row Level
# Security. Used to permanently delete accounts and, for email submission, to
# store Gmail tokens where users can't read them and record provider-confirmed
# submission results. Never share it.
SUPABASE_SECRET_KEY=

# --- AI (server only) ---------------------------------------------------------
# Which AI provider to use: gemini | anthropic
# Without a key for the chosen provider, Resolve still works: AI buttons show a
# clear "not available" message and complaints can be built from the template.
AI_PROVIDER=gemini

# Option A — Google Gemini (has a FREE tier, no card needed)
# Create a key at https://aistudio.google.com → "Get API key".
# Note: on the free tier Google may use submitted content to improve its
# products, and people may review it. Resolve tells users this before they opt in.
# Use test data (not real customers' documents) on the free tier.
GEMINI_API_KEY=
# Set to "true" only if billing is enabled on the key's Google Cloud project.
GEMINI_PAID_TIER=false

# Option B — Anthropic Claude (paid)
# Create a key at https://console.anthropic.com (Settings → API keys).
ANTHROPIC_API_KEY=
AI_EFFORT=medium
AI_REFUSAL_FALLBACK=default

# Model code for the chosen provider.
# Gemini: default gemini-3.5-flash (verified on a free key). Leave empty unless
#         you want a different model code from Google AI Studio. If a model is
#         unavailable or overloaded, Resolve switches to another Flash model.
# Anthropic: default claude-opus-5-5 (cheaper: claude-sonnet-5-5).
AI_MODEL=

# Maximum AI requests (analyses + drafts) per user per hour. Default: 10
# (On Gemini's free tier keep this low — the free quota is shared by all users.)
AI_RATE_LIMIT_PER_HOUR=10

# --- Sending complaints by email (Gmail) — server only -----------------------
# Lets users send their approved complaint from their OWN Gmail account and
# (optionally) lets Resolve find the bank's replies. Leave these empty to turn
# the feature off; users can still download the PDF or use the guided website
# option. Full setup steps: docs/SUBMISSIONS.md
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type "Web application"). Authorised redirect URI:
#   <SITE_URL>/api/integrations/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts stored Gmail tokens. 32 random bytes as base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later disconnects everyone's Gmail (they reconnect).
EMAIL_TOKEN_ENCRYPTION_KEY=
# Optional: override the OAuth redirect address (defaults to SITE_URL + path above).
GOOGLE_OAUTH_REDIRECT_URI=
# Protects the daily background job (/api/cron/submissions) that resolves
# interrupted sends and checks for replies. Any long random string. Vercel Cron
# sends it automatically when this variable is set on the project.
CRON_SECRET=
