# =============================================================================
# Resolve — environment variables
# Copy this file to `.env.local` for local development and fill in the values.
# NEVER commit `.env.local` or any real keys. `.env*` files are git-ignored
# (except this example).
# =============================================================================

# --- Site -------------------------------------------------------------------
# Public URL of the app. Used in email links (confirmation, password reset).
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API in the Supabase dashboard) -------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_…) or the legacy "anon" key.
# Safe for the browser: all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_…) or the legacy "service_role" key.
# SERVER ONLY — bypasses Row Level Security. Used only to permanently delete
# accounts. Never prefix with NEXT_PUBLIC_ and never share it.
SUPABASE_SECRET_KEY=

# --- AI (server only) ---------------------------------------------------------
# Which AI provider to use: gemini | anthropic
# Without a key for the chosen provider, Resolve still works: AI buttons show a
# clear "not available" message and complaints can be built from the template.
AI_PROVIDER=gemini

# Option A — Google Gemini (has a FREE tier, no card needed)
# Create a key at https://aistudio.google.com → "Get API key".
# Note: on the free tier Google may use submitted content to improve its
# products, and people may review it. Resolve tells users this before they opt in.
# Use test data (not real customers' documents) on the free tier.
GEMINI_API_KEY=
# Set to "true" only if billing is enabled on the key's Google Cloud project.
GEMINI_PAID_TIER=false

# Option B — Anthropic Claude (paid)
# Create a key at https://console.anthropic.com (Settings → API keys).
ANTHROPIC_API_KEY=
AI_EFFORT=medium
AI_REFUSAL_FALLBACK=default

# Model code for the chosen provider.
# Gemini: copy a model code shown in Google AI Studio (e.g. a "Flash" model);
#         if left empty, the alias gemini-flash-latest is used.
# Anthropic: default claude-opus-5-5 (cheaper: claude-sonnet-5-5).
AI_MODEL=

# Maximum AI requests (analyses + drafts) per user per hour. Default: 10
# (On Gemini's free tier keep this low — the free quota is shared by all users.)
AI_RATE_LIMIT_PER_HOUR=10
